# Generated by Cargo
# will have compiled files and executables
/target/
/.cargo-tools/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Sidecar binaries (dev/packaging prep — not committed)
/binaries/*
!/binaries/.gitkeep

# Staged local resources, kept out of the tree. The rule predates ADR 0019 and
# originally held crispasr copies; that runtime is retired and YAP_CRISPASR_BIN
# is read by nothing, so the rule is kept only because no build step is proven
# not to stage here.
/resources/
