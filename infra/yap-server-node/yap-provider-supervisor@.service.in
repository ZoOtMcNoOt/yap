[Unit]
Description=Yap supervised provider service (%i)
After=docker.service network.target
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=@YAP_PROVIDER_OWNER@
Group=@YAP_PROVIDER_GROUP@
EnvironmentFile=/etc/yap/providers/%i.env
RuntimeDirectory=yap-provider-%i
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/libexec/yap-provider-supervisor \
  --service %i \
  --profile ${YAP_PROVIDER_PROFILE} \
  --profile-sha256 ${YAP_PROVIDER_PROFILE_SHA256} \
  --candidate-lock ${YAP_PROVIDER_CANDIDATE_LOCK} \
  --state-path /run/yap-provider-%i/service-state.json \
  --launcher ${YAP_PROVIDER_LAUNCHER} \
  --
Restart=on-abnormal
RestartSec=5s
KillMode=mixed
TimeoutStopSec=20s
SendSIGKILL=yes
OOMPolicy=stop
TasksMax=512
LimitNOFILE=65536
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=no
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/yap-provider-%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
