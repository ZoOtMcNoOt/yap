[Unit]
Description=Yap multi-user agent admission broker
After=yap-provider-supervisor@rapid-automation.service yap-provider-supervisor@complex-orchestration.service

[Service]
Type=simple
User=@YAP_PROVIDER_OWNER@
Group=@YAP_PROVIDER_GROUP@
RuntimeDirectory=yap-agent-admission
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/libexec/yap-agent-admission-broker \
  --socket-path /run/yap-agent-admission/agent-admission.sock \
  --candidate-lock /usr/local/share/yap/agent-reasoning-candidates.lock.json \
  --rapid-profile /usr/local/share/yap/agent-service-profiles/rapid-automation.json \
  --rapid-profile-sha256 @YAP_RAPID_PROFILE_SHA256@ \
  --rapid-state-path /run/yap-provider-rapid-automation/service-state.json \
  --complex-profile /usr/local/share/yap/agent-service-profiles/complex-orchestration.json \
  --complex-profile-sha256 @YAP_COMPLEX_PROFILE_SHA256@ \
  --complex-state-path /run/yap-provider-complex-orchestration/service-state.json
# Admission state is intentionally not reconstructed across a broker crash.
# Keep failure closed until an operator has contained any external worker.
Restart=no
KillMode=mixed
TimeoutStopSec=5s
TasksMax=128
LimitNOFILE=256
MemoryMax=256M
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/yap-agent-admission
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
