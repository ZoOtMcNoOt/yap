{
  "schemaVersion": 2,
  "gateId": "integrated-identity-access",
  "candidateCells": [
    {
      "id": "frontend.node-runtime",
      "executor": "command",
      "cwd": "desktop",
      "command": [
        "node",
        "./tests/scripts/assert-node24.mjs"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "frontend.dependencies",
      "executor": "command",
      "cwd": "desktop",
      "command": [
        "corepack",
        "pnpm@11.7.0",
        "install",
        "--frozen-lockfile"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "frontend.dependency-audit",
      "executor": "command",
      "cwd": "desktop",
      "command": [
        "pnpm",
        "audit:dependencies"
      ],
      "timeoutMs": 900000
    },
    {
      "id": "frontend.release-contracts",
      "executor": "command",
      "cwd": "desktop",
      "command": [
        "pnpm",
        "test:release-contract"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "frontend.provenance",
      "executor": "command",
      "cwd": "desktop",
      "command": [
        "node",
        "./tests/scripts/assert-third-party-provenance.mjs",
        "--require-reviewed",
        "--verify-upstream"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "frontend.unit",
      "executor": "command",
      "cwd": "desktop",
      "command": [
        "pnpm",
        "test"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "frontend.production-build",
      "executor": "command",
      "cwd": "desktop",
      "command": [
        "pnpm",
        "build"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "frontend.chromium-runtime",
      "executor": "command",
      "cwd": "desktop",
      "command": [
        "pnpm",
        "exec",
        "playwright",
        "install",
        "chromium"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "frontend.browser-workflows",
      "executor": "command",
      "cwd": "desktop",
      "command": [
        "pnpm",
        "test:e2e"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "native.format",
      "executor": "command",
      "cwd": "desktop/src-tauri",
      "command": [
        "cargo",
        "fmt",
        "--all",
        "--check"
      ],
      "timeoutMs": 300000
    },
    {
      "id": "native.clippy",
      "executor": "command",
      "cwd": "desktop/src-tauri",
      "command": [
        "cargo",
        "clippy",
        "--locked",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "timeoutMs": 3600000
    },
    {
      "id": "native.tests",
      "executor": "command",
      "cwd": "desktop/src-tauri",
      "command": [
        "cargo",
        "test",
        "--locked"
      ],
      "timeoutMs": 3600000
    },
    {
      "id": "native.server-connector",
      "executor": "command",
      "cwd": ".",
      "command": [
        "pwsh.exe",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./verification/test-server-connector.ps1"
      ],
      "timeoutMs": 900000
    },
    {
      "id": "native.authenticated-server-connector",
      "executor": "command",
      "cwd": ".",
      "command": [
        "pwsh.exe",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./verification/test-authenticated-server-connector.ps1"
      ],
      "timeoutMs": 900000
    },
    {
      "id": "native.windows-dependency-boundary",
      "executor": "command",
      "cwd": ".",
      "command": [
        "pwsh.exe",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./verification/test-windows-rust-dependency-boundary.ps1"
      ],
      "timeoutMs": 900000
    },
    {
      "id": "native.dependency-audit",
      "executor": "command",
      "cwd": ".",
      "command": [
        "pwsh.exe",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./verification/audit-windows-rust-dependencies.ps1"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "desktop.wdio-build",
      "executor": "command",
      "cwd": "desktop",
      "command": [
        "pnpm",
        "test:desktop:build"
      ],
      "timeoutMs": 3600000
    },
    {
      "id": "desktop.required-wdio",
      "executor": "command",
      "cwd": "desktop",
      "command": [
        "pnpm",
        "exec",
        "wdio",
        "run",
        "./tests/wdio.required.conf.ts"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "server.python-3.12",
      "executor": "command",
      "cwd": ".",
      "command": [
        "pwsh.exe",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./verification/test-portable-python-server.ps1"
      ],
      "timeoutMs": 3600000
    },
    {
      "id": "server.lint",
      "executor": "command",
      "cwd": "server",
      "command": [
        "uv",
        "run",
        "--locked",
        "ruff",
        "check",
        ".",
        "../infra/yap-server-node/owned-process-supervisor.py"
      ],
      "timeoutMs": 900000
    },
    {
      "id": "server.mock-oidc-owner-flow",
      "executor": "private-receipt",
      "receiptContract": "mock-oidc-owner-flow-v1"
    },
    {
      "id": "target-client.native-resource-and-restart",
      "executor": "private-receipt",
      "receiptContract": "target-client-native-resource-v4"
    },
    {
